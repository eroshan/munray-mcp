{
  "contracts": {
    "core.async.result": {
      "description": "Async start call: (task_id, err). Later: async_task.wait/result(task_id) -> (result, err).",
      "example": "task_id, err = some.ns.expensive_op(opts)",
      "pattern": "task_id, err = fn(...); if err then ... end; result, err = async_task.wait(task_id)"
    },
    "core.iter": {
      "description": "Iterator; consume via for ... in ... or helpers.collect(iterator, {limit=N}) / helpers.take(iterator, N)",
      "example": "items, err = helpers.collect(some.ns.list(opts), {limit = 10})",
      "pattern": "items, err = helpers.collect(iterator, {limit = 10})"
    },
    "core.result": {
      "description": "(val, err). Always check err first.",
      "example": "diffs, err = gitlab.mr.diff(repo, iid, {})",
      "pattern": "val, err = fn(...)"
    },
    "error": "{code:string, message:string, recoverable?:boolean, context?:table}"
  },
  "conventions": {
    "ctx": "scope (repo, project_key, space_key)",
    "data": "payload table {field=value}",
    "id": "identifier (id, iid, key, sha)",
    "opts": "filters/config table; optional args are marked with ?"
  },
  "discovery": {
    "examples": "capabilities.examples(target)",
    "invalidate": "capabilities.invalidate()",
    "schema": "capabilities.schema(target)",
    "target_format": {
      "note": "Use target names from the namespaces listed in this response.",
      "pattern": "<service> | <service>.<resource>"
    }
  },
  "hints": {
    "global": [
      "Use capabilities.schema(target) for types/docs",
      "Use capabilities.examples(target) for code",
      "Ops ending with * are mutating; require mutating mode"
    ],
    "namespaces": {
      "vfs": "Sandboxed runtime-local VFS, not host filesystem. Paths are VFS-relative; use vfs.expose() for host-visible temp copies."
    }
  },
  "iter_helpers": [
    "collect",
    "first",
    "take",
    "skip",
    "page"
  ],
  "namespaces": {
    "async_task": {
      "result": "(task_id, opts?) -> core.result",
      "status": "(task_id) -> core.result",
      "wait": "(task_id, timeout_ms?) -> core.result"
    },
    "compass": {
      "component": "(id, opts) -> core.result",
      "componentLogs": "(component_id, opts) -> core.iter",
      "components": "(ids, opts) -> core.result",
      "ready": "() -> core.result",
      "searchComponents": "(query, opts) -> core.iter"
    },
    "confluence": {
      "page": {
        "content": "(id, opts?) -> core.result",
        "create": "(space_key, data)* -> core.result",
        "find": "(url) -> core.result",
        "find_and_replace": "(id, search, replacement, opts?)* -> core.result",
        "get": "(id, opts?) -> core.result",
        "list": "(space_key, opts?) -> core.iter",
        "update": "(id, data)* -> core.result"
      },
      "ready": "() -> core.result",
      "search": {
        "find": "(cql, opts?) -> core.iter",
        "pages": "(query, opts?) -> core.iter"
      }
    },
    "gcloud": {
      "bigquery": {
        "describe": "(project, table, [opts]) -> core.result",
        "query": "(project, sql, [opts]) -> core.result",
        "show": "(project, table, [opts]) -> core.result"
      },
      "logs": {
        "get": "(project, filter, [opts]) -> core.async.result"
      },
      "monitoring": {
        "alert": {
          "describe": "(alert, opts?) -> core.result",
          "list": "(project, opts?) -> core.iter"
        },
        "descriptor": {
          "list": "(project, opts?) -> core.iter"
        },
        "policy": {
          "describe": "(policy, opts?) -> core.result",
          "list": "(project, opts?) -> core.iter"
        },
        "series": {
          "list": "(project, opts) -> core.iter"
        }
      },
      "project": {
        "list": "([opts]) -> core.result"
      }
    },
    "gitlab": {
      "branch": {
        "create": "(repo, data)* -> core.result",
        "delete": "(repo, branch_name)* -> core.result",
        "get": "(repo, branch_name) -> core.result",
        "list": "(repo, opts) -> core.iter"
      },
      "commit": {
        "diff": "(repo, sha, opts) -> core.result",
        "get": "(repo, sha) -> core.result",
        "list": "(repo, opts) -> core.iter"
      },
      "job": {
        "artifact_download": "(repo, id, opts) -> core.result",
        "get": "(repo, id) -> core.result",
        "list": "(repo, pipeline_id, opts) -> core.iter",
        "log": "(repo, id) -> core.result",
        "pipeline": "(repo, id) -> core.result",
        "play": "(repo, id)* -> core.result",
        "retry": "(repo, id)* -> core.result",
        "trigger_jobs": "(repo, pipeline_id, opts) -> core.iter"
      },
      "mr": {
        "approve": "(repo, iid)* -> core.result",
        "close": "(repo, iid)* -> core.result",
        "create": "(repo, data)* -> core.result",
        "diff": "(repo, iid, opts) -> core.result",
        "diff_refs": "(repo, iid) -> core.result",
        "discussion": "(repo, iid, discussion_id) -> core.result",
        "discussion_create": "(repo, iid, body, position)* -> core.result",
        "discussions": "(repo, iid, opts) -> core.iter",
        "get": "(repo, iid) -> core.result",
        "list": "(repo, opts) -> core.iter",
        "merge": "(repo, iid, opts)* -> core.result",
        "pipelines": "(repo, iid, opts) -> core.iter",
        "reopen": "(repo, iid)* -> core.result",
        "update": "(repo, iid, data, opts)* -> core.result"
      },
      "pipeline": {
        "cancel": "(repo, id)* -> core.result",
        "create": "(repo, data)* -> core.result",
        "downstream_pipelines": "(repo, pipeline_id, opts) -> core.iter",
        "get": "(repo, id) -> core.result",
        "jobs": "(repo, pipeline_id, opts) -> core.iter",
        "list": "(repo, opts) -> core.iter",
        "merge_request": "(repo, id) -> core.result",
        "retry": "(repo, id)* -> core.result",
        "trigger_jobs": "(repo, pipeline_id, opts) -> core.iter"
      },
      "repo": {
        "branches": "(repo, opts) -> core.iter",
        "compare": "(repo, from, to) -> core.result",
        "file": "(repo, path, ref) -> core.result",
        "get": "(repo) -> core.result",
        "tree": "(repo, opts) -> core.iter"
      },
      "search": {
        "find": "(scope, query, opts) -> core.iter"
      }
    },
    "helpers": {
      "collect": "(iterator, opts) -> core.result",
      "contains": "(str, substr) -> core.result",
      "copy": "(t) -> core.result",
      "filter": "(arr, pred) -> core.result",
      "find": "(arr, pred) -> core.result",
      "first": "(iterator) -> core.result",
      "get_in": "(obj, path, default) -> core.result",
      "keys": "(t) -> core.result",
      "map": "(arr, fn) -> core.result",
      "page": "(iterator, page_num, page_size) -> core.result",
      "starts_with": "(str, prefix) -> core.result",
      "take": "(iterator, n) -> core.result"
    },
    "ingest": {
      "get": "(token) -> core.result"
    },
    "jira": {
      "field": {
        "list": "(opts) -> core.iter"
      },
      "issue": {
        "create": "(data)* -> core.result",
        "find": "(query, opts) -> core.iter",
        "get": "(issue_key, opts) -> core.result",
        "hierarchy": "(issue_key, opts) -> core.result",
        "list": "(project_key, opts) -> core.iter",
        "parent": "(child_key, opts) -> core.result",
        "subtasks": "(parent_key, opts) -> core.result",
        "transition": "(key, transition_id, opts)* -> core.result",
        "update": "(key, data, opts)* -> core.result"
      },
      "project": {
        "get": "(project_key, opts) -> core.result",
        "list": "(opts) -> core.iter"
      },
      "ready": "() -> core.result"
    },
    "json": {
      "decode": "(json_string) -> core.result",
      "encode": "(value, [pretty]) -> core.result"
    },
    "store": {
      "cache_get": "(key) -> core.result",
      "clear": "(type_name)* -> core.result",
      "delete": "(type_name, key)* -> core.result",
      "get": "(type_name, key) -> core.result",
      "keys": "(type_name) -> core.result",
      "len": "(type_name) -> core.result",
      "put": "(type_name, key, value, opts?)* -> core.result",
      "save_snippet": "(path, fn_lua, opts?) | (def)* -> core.result"
    },
    "terraform": {
      "parse_plan": "(log) -> core.result"
    },
    "vfs": {
      "ensure_parent": "(path) -> core.result",
      "expose": "(paths)* -> core.result",
      "ls": "(path, opts?) -> core.result",
      "mkdirp": "(path) -> core.result",
      "read_text": "(path, opts?) -> core.result",
      "stat": "(path) -> core.result",
      "to_txt": "(path, opts?) -> core.result",
      "write_text": "(path, text, opts?) -> core.result"
    },
    "yaml": {
      "decode": "(yaml_string) -> core.result",
      "encode": "(value, [pretty]) -> core.result"
    }
  },
  "runtime": []
}
